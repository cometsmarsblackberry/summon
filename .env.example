# Database
DATABASE_URL=sqlite+aiosqlite:////data/reserve.db

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Cloud Providers (configure at least one)
VULTR_API_KEY=
GCORE_API_KEY=
GCORE_PROJECT_ID=0
ONIDEL_API_KEY=
ONIDEL_TEAM_ID=

# Operator-owned Instant hosts (disabled for additive rollout by default).
# These are fallback defaults; administrators can change the rollout switch
# and shared image from the Instant Hosts tab after startup.
INSTANT_HOSTS_ENABLED=false
INSTANT_CONTAINER_IMAGE=ghcr.io/cometsmarsblackberry/tf2-summon/i386:nightly
INSTANT_HOST_OFFLINE_SECONDS=30

# Steam
STEAM_API_KEY=

# hCaptcha (optional)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# TF2 API Keys (get from demos.tf and logs.tf)
DEMOS_TF_APIKEY=
LOGS_TF_APIKEY=

# Branding
# SITE_NAME=Summon
# LOGO_URL=
# FAVICON_URL=
# OG_IMAGE_URL=
# DISCORD_URL=
# STEAM_GROUP_URL=
# CONTACT_EMAIL=
# RULES_URL=
# LOGIN_IMAGE_URL=
# LOGIN_IMAGE_WIDE_URL=
# CUSTOM_CONFIG_PREFIXES=

# Base URL — the public domain users see (used for Steam callbacks, links, etc.)
BASE_URL=http://localhost:8000

# Production reverse proxy image (optional).
# The production Compose file defaults to the official caddy:2.11.4-alpine image.
# CADDY_IMAGE=caddy:2.11.4-alpine

# FastAPI docs exposure (optional).
# Defaults to enabled on localhost and disabled for non-localhost BASE_URL values.
# EXPOSE_API_DOCS=false

# Origin hostname (optional) — set this when behind a CDN.
# Caddy will serve on this hostname and get a TLS cert for it via HTTP-01,
# so no DNS API key is needed. When unset, the production Compose file uses
# BASE_URL for direct access without a CDN.
# Example: ORIGIN_HOSTNAME=origin.example.com
# ORIGIN_HOSTNAME=

# Internal API key for SourceMod plugin to backend communication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# Temporary compatibility toggles for rolling upgrades.
# Leave disabled for the secure defaults.
# ALLOW_LEGACY_INTERNAL_API_KEY=false
# ALLOW_LEGACY_AGENT_QUERY_TOKEN=false

# Admin Steam IDs (comma-separated Steam64 IDs)
ADMIN_STEAM_IDS=

# Beta mode — when true, only admins and allowlisted users can use the site
BETA_MODE=true

# Non-admin Steam IDs allowed during beta mode (comma-separated Steam64 IDs)
BETA_ALLOWLIST_STEAM_IDS=

# IPinfo token for geolocation (optional — ping submissions work without it)
IPINFO_TOKEN=

# SSH public key for debugging access to cloud instances (optional)
SSH_PUBKEY=

# S3 storage for server logs (optional — Gcore S3 compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Logging (logs written to LOG_DIR/app.log with rotation)
LOG_DIR=/data/logs
LOG_LEVEL=INFO
